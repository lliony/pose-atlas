{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pose-atlas",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.ts",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/ai/*"]
  },
  "observability": { "enabled": true }
}
