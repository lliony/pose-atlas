# 复制为 .env.local（本地）或写入部署环境变量；不要提交真实密钥。

# ── 前端 ───────────────────────────────────────────────
# local / 留空 = 本机模式（数据存 IndexedDB，无账号、无云端）
# api = 调用同源 /api（需要自建数据后端，见 docs/deploy.md）
VITE_DATA_MODE=local
# 设为 1 时隐藏顶部“本机演示模式”横幅（数据仍然只在浏览器里）
VITE_HIDE_DEMO=

# ── 开发/预览代理（只影响 vite dev / preview）──────────
# 数据后端地址，例如 http://127.0.0.1:3000
# API_PROXY_TARGET=http://127.0.0.1:3000
# AI 服务地址
AI_PROXY_TARGET=http://127.0.0.1:5175

# ── AI 服务（系统级配置，运维填一次，用户无需设置）──────
HOST=127.0.0.1
PORT=5175
# 允许调用的页面来源，逗号分隔；线上要改成你的域名
# AI_ALLOWED_ORIGINS=https://pose.example.com
# 系统默认模型（不填则只能用用户自己的模型档案）
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=your-server-secret
# AI_MODEL=your-vision-model
